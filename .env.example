# URL base de la API backend de SimpleLab (ejemplo local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5084

# URL pública de la instancia de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima pública de Supabase (no usar Service Role ni claves administrativas)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
